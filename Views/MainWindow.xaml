<Window x:Class="AmberolWpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:AmberolWpf.Helpers"
        Title="Amberol" 
        Height="520" 
        Width="1140"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        SourceInitialized="Window_SourceInitialized"
        FontFamily="Google Sans, Segoe UI, Arial">

    <Window.Resources>
        <helpers:Base64ToImageConverter x:Key="Base64ToImageConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        
        <!-- Reusable Icon Button Style -->
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="100" 
                                Padding="{TemplateBinding Padding}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1AFFFFFF"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="border" 
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" 
                                                             To="1.05" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="border" 
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" 
                                                             To="1.05" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="border" 
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" 
                                                             To="1.0" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="border" 
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" 
                                                             To="1.0" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#33FFFFFF"/>
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Standard Button Style -->
        <Style x:Key="TextButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1AFFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4DFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Switch Toggle Button Style -->
        <Style x:Key="ModernSwitchStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Cursor="Hand">
                            <Border x:Name="BackgroundBorder" Background="#26FFFFFF" CornerRadius="12" BorderBrush="#1CFFFFFF" BorderThickness="1" SnapsToDevicePixels="True"/>
                            <Ellipse x:Name="Thumb" Fill="#B3FFFFFF" Width="16" Height="16" HorizontalAlignment="Left" Margin="4,0,0,0" SnapsToDevicePixels="True">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform X="0"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="BackgroundBorder" Property="Background" Value="#FF2563EB"/>
                                <Setter TargetName="BackgroundBorder" Property="BorderBrush" Value="#FF3B82F6"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="White"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="18" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Thumb" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox Dark Flat Style -->
        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#1CFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" Focusable="false" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Border" CornerRadius="0" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1" Fill="#B3FFFFFF" HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center" Data="M0 0l4 4 4-4z" Stretch="Uniform" Width="8"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#26FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid x:Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" Background="#F212131A" BorderBrush="#26FFFFFF" BorderThickness="1.5" CornerRadius="0"/>
                                    <ScrollViewer Margin="4" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBoxItem Style -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#14FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#FF2563EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Equalizer Slider Style -->
        <Style x:Key="EqSliderStyle" TargetType="Slider">
            <Setter Property="Orientation" Value="Vertical"/>
            <Setter Property="Minimum" Value="-15"/>
            <Setter Property="Maximum" Value="15"/>
            <Setter Property="Height" Value="120"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <!-- Track -->
                            <Border Width="3" Background="#33FFFFFF" HorizontalAlignment="Center" CornerRadius="1.5"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Background="Transparent" BorderBrush="Transparent" Opacity="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Background="Transparent" BorderBrush="Transparent" Opacity="0"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="12" Height="12">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="White" Width="12" Height="12" Stroke="#FF1C1D24" StrokeThickness="1.5"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{x:Null}">
        <!-- Dynamic Backdrop Container (Animate Margin left and Width dynamically in code-behind) -->
        <Border x:Name="BackdropBorder" Width="380" Height="520" Margin="380,0,380,0" HorizontalAlignment="Left" CornerRadius="0" ClipToBounds="True" BorderBrush="#26FFFFFF" BorderThickness="1.5" Background="#FF12131A">
            <Grid>
                <!-- Blurred album cover art (Layer 1) -->
                <Image x:Name="BlurredBgImage" Stretch="UniformToFill" Opacity="0.25">
                    <Image.Effect>
                        <BlurEffect Radius="48" KernelType="Gaussian"/>
                    </Image.Effect>
                </Image>

                <!-- Dynamic Gradients (Layers 2, 3, 4) -->
                <Grid x:Name="GradientBgGrid" Opacity="0.45">
                    <!-- Base linear gradient -->
                    <Rectangle x:Name="LinearGradientRect" Stretch="Fill">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF0B0C10" Offset="0"/>
                                <GradientStop Color="#FF1F2833" Offset="0.5"/>
                                <GradientStop Color="#FF0B0C10" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    
                    <!-- Glowing corner light source 1 (radial) -->
                    <Rectangle x:Name="RadialGradientRect1" Stretch="Fill">
                        <Rectangle.Fill>
                            <RadialGradientBrush Center="0.8,0.1" GradientOrigin="0.8,0.1" RadiusX="0.6" RadiusY="0.6">
                                <GradientStop Color="#4D59A073" Offset="0"/>
                                <GradientStop Color="#00000000" Offset="1"/>
                            </RadialGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <!-- Glowing corner light source 2 (radial) -->
                    <Rectangle x:Name="RadialGradientRect2" Stretch="Fill">
                        <Rectangle.Fill>
                            <RadialGradientBrush Center="0.1,0.9" GradientOrigin="0.1,0.9" RadiusX="0.6" RadiusY="0.6">
                                <GradientStop Color="#3D455012" Offset="0"/>
                                <GradientStop Color="#00000000" Offset="1"/>
                            </RadialGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                </Grid>

                <!-- Frosted Glass Overlay (Layer 5) -->
                <Border Background="#3D000000" BorderBrush="Transparent" BorderThickness="0" />
            </Grid>
        </Border>

        <!-- ================= MAIN THREE-COLUMN GRID ================= -->
        <Grid Background="{x:Null}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/> <!-- Column 0: Queue Overlay -->
                <ColumnDefinition Width="380"/> <!-- Column 1: Main Player -->
                <ColumnDefinition Width="380"/> <!-- Column 2: Lyrics Overlay -->
            </Grid.ColumnDefinitions>

            <!-- ================= LEFT COLUMN: PLAY QUEUE ================= -->
            <Grid Grid.Column="0" ClipToBounds="True">
                <Grid x:Name="QueuePane" Margin="24,12,0,24">
                    <Grid.RenderTransform>
                        <TranslateTransform X="380"/>
                    </Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>       <!-- Spacing / Title Drag -->
                    <RowDefinition Height="Auto"/>     <!-- Open Folder button -->
                    <RowDefinition Height="Auto"/>     <!-- Playlists Section -->
                    <RowDefinition Height="Auto"/>     <!-- Play Queue Header -->
                    <RowDefinition Height="*"/>        <!-- Queue List -->
                    <RowDefinition Height="Auto"/>     <!-- Clear Cache button -->
                </Grid.RowDefinitions>

                <!-- Titlebar drag handle for Queue column -->
                <Border Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"/>

                <!-- Row 1: Open Folder button -->
                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Button Style="{StaticResource TextButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="ScanFolder_Click" Height="36" Background="#14FFFFFF" BorderBrush="#1CFFFFFF" BorderThickness="1" Padding="12,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconFolder}" Stroke="White" StrokeThickness="1.8" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/>
                            <TextBlock Text="Open Folder" Foreground="White" FontSize="13" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Row 2: Playlists Section -->
                <Grid Grid.Row="2" Margin="0,4,0,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <Grid Grid.Row="0" Margin="4,0,0,6">
                        <TextBlock Text="PLAYLISTS" Foreground="#80FFFFFF" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource IconButtonStyle}" Width="20" Height="20" HorizontalAlignment="Right" Click="CreatePlaylist_Click" ToolTip="Create Playlist" Margin="0,0,8,0">
                            <Path Data="{StaticResource IconPlus}" Fill="#80FFFFFF" Width="10" Height="10" Stretch="Uniform"/>
                        </Button>
                    </Grid>
                    
                    <ListBox x:Name="PlaylistsListBox" Grid.Row="1" Background="Transparent" BorderThickness="0" SelectionChanged="PlaylistsListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2" Height="32" Width="332">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Data="{StaticResource IconPlaylist}" Fill="#99FFFFFF" Width="12" Height="12" Stretch="Uniform" Margin="4,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                                    <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Width="28" Height="28" Click="PlayPlaylist_Click" Tag="{Binding}" ToolTip="Play Playlist" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconPlay}" Fill="#B3FFFFFF" Width="10" Height="10" Stretch="Uniform"/>
                                    </Button>
                                    <Button Grid.Column="3" Style="{StaticResource IconButtonStyle}" Width="28" Height="28" Click="DeletePlaylist_Click" Tag="{Binding}" ToolTip="Delete Playlist" VerticalAlignment="Center" Visibility="{Binding CanDelete, Converter={StaticResource BoolToVisConverter}}" Margin="4,0,0,0">
                                        <Path Data="{StaticResource IconTrash}" Fill="#80FF5555" Width="10" Height="10" Stretch="Uniform"/>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="8,2"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="0" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#14FFFFFF"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#33FFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Grid>

                <!-- Row 3: Play Queue Header -->
                <Grid Grid.Row="3" Margin="0,4,0,8">
                    <TextBlock x:Name="PlayQueueHeaderTitle" Text="Play Queue" Foreground="#80FFFFFF" FontSize="10.5" FontWeight="Bold" Margin="4,0,0,0"/>
                </Grid>

                <!-- Row 4: Queue List -->
                <ListBox x:Name="QueueListBox" Grid.Row="4" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Hidden" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="QueueListBox_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4" Width="332">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="6" ClipToBounds="True" Background="#33FFFFFF" Margin="0,0,10,0">
                                    <Image Source="{Binding CoverArt, Converter={StaticResource Base64ToImageConverter}}" Stretch="UniformToFill"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" Foreground="White" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Artist}" Foreground="#99FFFFFF" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding DurationString}" Foreground="#66FFFFFF" FontSize="11" VerticalAlignment="Center" Margin="10,0,10,0"/>
                                <Button Grid.Column="3" Style="{StaticResource IconButtonStyle}" Width="24" Height="24" Click="RemoveFromQueue_Click" Tag="{Binding}" ToolTip="Remove from Queue" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconTrash}" Fill="#B3FFFFFF" Width="10" Height="10" Stretch="Uniform"/>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="8,6"/>
                            <Setter Property="Margin" Value="0,2"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="0" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#1AFFFFFF"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#33FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <!-- Row 5: Clear Cache Center Bottom -->
                <Grid Grid.Row="5" Margin="0,12,0,0" HorizontalAlignment="Center">
                    <Button Style="{StaticResource TextButtonStyle}" Height="28" Padding="12,2" Background="#0AFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" Click="ClearCache_Click">
                        <TextBlock Text="Clear Cache" Foreground="#80FFFFFF" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Button>
                </Grid>
            </Grid>
        </Grid>

            <!-- ================= MIDDLE COLUMN: MAIN MUSIC PLAYER ================= -->
            <Grid Grid.Column="1" Margin="24,12,24,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>       <!-- Title bar & system controls -->
                    <RowDefinition Height="*"/>        <!-- Album Art / Welcome screen -->
                    <RowDefinition Height="Auto"/>     <!-- Track Info -->
                    <RowDefinition Height="Auto"/>     <!-- Waveform Progress -->
                    <RowDefinition Height="Auto"/>     <!-- Times & Quality badge -->
                    <RowDefinition Height="Auto"/>     <!-- Playback Controls -->
                    <RowDefinition Height="Auto"/>     <!-- Bottom Toolbar -->
                </Grid.RowDefinitions>

                <!-- Row 0: Custom drag title bar and controls -->
                <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <!-- Queue Button on Top Left -->
                    <Button x:Name="QueueToggleButton" Style="{StaticResource IconButtonStyle}" Width="28" Height="28" HorizontalAlignment="Left" Click="QueueToggleButton_Click" ToolTip="Show Play Queue">
                        <Path Data="{StaticResource IconHamburger}" Stroke="#B3FFFFFF" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButtonStyle}" Width="28" Height="28" Click="MinimizeButton_Click">
                            <Path Data="{StaticResource IconMinimize}" Stroke="White" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform"/>
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}" Width="28" Height="28" Margin="8,0,0,0" Click="CloseButton_Click">
                            <Path Data="{StaticResource IconClose}" Stroke="White" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Row 1: Album Art or Welcome Screen container -->
                <Grid Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <!-- Welcome Screen (scans folder) -->
                    <StackPanel x:Name="WelcomePanel" Visibility="Visible" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="110" Height="110" CornerRadius="0" ClipToBounds="True" HorizontalAlignment="Center" Margin="0,0,0,24">
                            <Image Source="file:///d:/Projects/amberol-windows/icon.png" Stretch="UniformToFill"/>
                        </Border>
                        <TextBlock Text="Amberol" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,24,0,0"/>
                        <TextBlock Text="Select a folder or add songs to compile your minimalist offline listening library." 
                                   Foreground="#B3FFFFFF" FontSize="12.5" TextAlignment="Center" TextWrapping="Wrap" Width="260" LineHeight="18" Margin="0,12,0,0"/>
                        <Button Style="{StaticResource TextButtonStyle}" Content="Add Folder" Click="ScanFolder_Click" Margin="0,24,0,0" Width="160" Background="#FF2563EB" FontWeight="Bold"/>
                    </StackPanel>

                    <!-- Now Playing Cover Art -->
                    <Border x:Name="AlbumArtBorder" Width="180" Height="180" CornerRadius="0" ClipToBounds="True" Visibility="Collapsed" BorderBrush="#33FFFFFF" BorderThickness="1" SnapsToDevicePixels="True">
                        <Grid>
                            <!-- Default cover placeholder -->
                            <Border Background="#1AFFFFFF">
                                <Path Data="{StaticResource IconMusicNote}" Fill="#B3FFFFFF" Width="60" Height="60" Stretch="Uniform"/>
                            </Border>
                            <!-- Album art image -->
                            <Image x:Name="AlbumArtImage" Stretch="UniformToFill"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Row 2: Track Info (Title, Artist, and Action Buttons) -->
                <Grid Grid.Row="2" x:Name="TrackInfoPanel" Visibility="Collapsed" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <!-- Track Title -->
                        <TextBlock x:Name="TrackTitleText" Text="Song Title" Foreground="White" FontSize="19" FontWeight="ExtraBold" TextTrimming="CharacterEllipsis"/>
                        <!-- Artist Name -->
                        <TextBlock x:Name="TrackArtistText" Text="Artist Name" Foreground="#CCFFFFFF" FontSize="13" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- Action buttons: Star (Favorite) and Option dot -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButtonStyle}" Width="36" Height="36" Click="FavoriteButton_Click" ToolTip="Favorite">
                            <Path x:Name="FavoriteStarPath" Data="{StaticResource IconStarOutline}" Fill="Transparent" Stroke="White" StrokeThickness="1.5" Width="18" Height="18" Stretch="Uniform"/>
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}" Width="36" Height="36" Margin="4,0,0,0" Click="OptionsButton_Click" ToolTip="More Options">
                            <Path Data="{StaticResource IconMoreOptions}" Fill="White" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Row 3: Waveform Progress Bar -->
                <Canvas x:Name="WaveformCanvas" Grid.Row="3" Height="42" Visibility="Collapsed" Margin="0,16,0,0" Background="Transparent"
                        MouseDown="WaveformCanvas_PointerPressed" Cursor="Hand"/>

                <!-- Row 4: Timeline labels (Current Time, Lossless badge, Total Time) -->
                <Grid Grid.Row="4" x:Name="TimeLabelsPanel" Visibility="Collapsed" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Current playback position -->
                    <TextBlock x:Name="CurrentTimeText" Grid.Column="0" Text="0:00" Foreground="#C6FFFFFF" FontSize="11" FontFamily="Consolas, Courier New"/>

                    <!-- Quality Badge in middle -->
                    <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#14FFFFFF" CornerRadius="0" Padding="6,1.5,6,2.5" BorderBrush="#1CFFFFFF" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconMusicNote}" Fill="#B3FFFFFF" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center"/>
                            <TextBlock x:Name="QualityBadgeText" Text="Lossless" Foreground="#B3FFFFFF" FontSize="9" FontWeight="Bold" Margin="4,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Remaining time -->
                    <TextBlock x:Name="RemainingTimeText" Grid.Column="2" Text="0:00" Foreground="#C6FFFFFF" FontSize="11" FontFamily="Consolas, Courier New"/>
                </Grid>

                <!-- Row 5: Playback Control Pill (Shuffle on Left, Repeat on Right, Playback Controls Centered) -->
                <Grid Grid.Row="5" x:Name="PlaybackControlsPanel" Visibility="Collapsed" Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- Shuffle -->
                        <ColumnDefinition Width="*"/>    <!-- Center spacing -->
                        <ColumnDefinition Width="Auto"/> <!-- Prev/Play/Next -->
                        <ColumnDefinition Width="*"/>    <!-- Center spacing -->
                        <ColumnDefinition Width="Auto"/> <!-- Repeat -->
                    </Grid.ColumnDefinitions>

                    <!-- Shuffle on the far left -->
                    <Button x:Name="ShuffleButton" Grid.Column="0" Style="{StaticResource IconButtonStyle}" Width="36" Height="36" Click="ShuffleButton_Click" ToolTip="Shuffle Off" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconShuffle}" Fill="#66FFFFFF" Width="18" Height="18" Stretch="Uniform"/>
                    </Button>

                    <!-- Main controls in the center -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Previous -->
                        <Button Style="{StaticResource IconButtonStyle}" Width="44" Height="44" Click="PreviousButton_Click" ToolTip="Previous Track" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconPrevious}" Fill="White" Width="16" Height="16" Stretch="Uniform"/>
                        </Button>
                        <!-- Play/Pause -->
                        <Button x:Name="PlayPauseButton" Style="{StaticResource IconButtonStyle}" Width="58" Height="58" Margin="16,0,16,0" Click="PlayPauseButton_Click" Background="#33FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1" ToolTip="Play / Pause" VerticalAlignment="Center">
                            <Path x:Name="PlayPauseIcon" Data="{StaticResource IconPlay}" Fill="White" Width="22" Height="22" Stretch="Uniform" Margin="4,0,0,0"/>
                        </Button>
                        <!-- Next -->
                        <Button Style="{StaticResource IconButtonStyle}" Width="44" Height="44" Click="NextButton_Click" ToolTip="Next Track" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconNext}" Fill="White" Width="16" Height="16" Stretch="Uniform"/>
                        </Button>
                    </StackPanel>

                    <!-- Repeat on the far right -->
                    <Button x:Name="RepeatButton" Grid.Column="4" Style="{StaticResource IconButtonStyle}" Width="36" Height="36" Click="RepeatButton_Click" ToolTip="Repeat Off" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconRepeat}" Fill="#66FFFFFF" Width="18" Height="18" Stretch="Uniform"/>
                    </Button>
                </Grid>

                <!-- Row 6: Bottom Toolbar (Equalizer on Left, Lyrics Toggle on Right) -->
                <Grid x:Name="BottomToolbarPanel" Grid.Row="6" Margin="0,20,0,0" VerticalAlignment="Bottom">
                    <Button x:Name="EqualizerButton" Style="{StaticResource IconButtonStyle}" Width="38" Height="38" HorizontalAlignment="Left" Click="EqualizerButton_Click" ToolTip="Equalizer">
                        <Path Data="{StaticResource IconEqualizer}" Fill="#B3FFFFFF" Width="18" Height="18" Stretch="Uniform"/>
                    </Button>
                    <Button x:Name="LyricsToggleButton" Style="{StaticResource IconButtonStyle}" Width="38" Height="38" HorizontalAlignment="Right" Click="LyricsToggleButton_Click" ToolTip="Toggle Lyrics">
                        <Path Data="{StaticResource IconLyrics}" Fill="#B3FFFFFF" Width="18" Height="18" Stretch="Uniform"/>
                    </Button>
                </Grid>

                <!-- Mini Equalizer Dialog Overlay Panel (Semi-transparent floating border restricted to Column 1) -->
                <Border x:Name="EqDialogOverlay" Grid.Row="0" Grid.RowSpan="7" Background="Transparent" Visibility="Collapsed" MouseLeftButtonDown="EqOverlay_MouseLeftButtonDown" Panel.ZIndex="1000">
                    <Border Width="310" Background="#F212131A" CornerRadius="0" BorderBrush="#26FFFFFF" BorderThickness="1.5" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="20" MouseLeftButtonDown="EqBorder_MouseLeftButtonDown">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Equalizer" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                                <ToggleButton x:Name="EqEnableToggle" Style="{StaticResource ModernSwitchStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="EqEnableToggle_Click"/>
                            </Grid>
                            
                            <Separator Background="#1CFFFFFF" Margin="0,12"/>

                            <!-- Presets Dropdown -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Preset" Foreground="#B3FFFFFF" FontSize="12.5" VerticalAlignment="Center"/>
                                <ComboBox x:Name="EqPresetComboBox" Style="{StaticResource DarkComboBoxStyle}" Grid.Column="1" Margin="12,0,0,0" SelectionChanged="EqPresetComboBox_SelectionChanged">
                                    <ComboBoxItem Content="Flat"/>
                                    <ComboBoxItem Content="Bass"/>
                                    <ComboBoxItem Content="Vocal"/>
                                    <ComboBoxItem Content="Pop"/>
                                    <ComboBoxItem Content="Classical"/>
                                    <ComboBoxItem Content="Rock"/>
                                    <ComboBoxItem Content="Custom"/>
                                </ComboBox>
                            </Grid>

                            <!-- EQ Sliders Grid -->
                            <Grid x:Name="SlidersGrid" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Border>
            </Grid>

            <!-- ================= RIGHT COLUMN: LYRICS ================= -->
            <Grid Grid.Column="2" ClipToBounds="True">
                <Grid x:Name="LyricsPane" Margin="0,12,24,24">
                    <Grid.RenderTransform>
                        <TranslateTransform X="-380"/>
                    </Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>       <!-- Spacing / Title Drag -->
                    <RowDefinition Height="*"/>        <!-- Synced Lyrics View -->
                    <RowDefinition Height="Auto"/>     <!-- Bottom controls -->
                </Grid.RowDefinitions>

                <!-- Titlebar drag handle for Lyrics column -->
                <Border Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"/>

                <ScrollViewer Grid.Row="1" x:Name="LyricsScrollViewer" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" SnapsToDevicePixels="True">
                    <StackPanel x:Name="LyricsStackPanel" Margin="0,150,0,150" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                        <TextBlock x:Name="NoLyricsPlaceholder" Text="No Lyrics Found" Foreground="#66FFFFFF" FontSize="16" FontWeight="SemiBold" TextAlignment="Center" Margin="0,50,0,0"/>
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="2" Margin="0,20,0,0" VerticalAlignment="Bottom">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Style="{StaticResource IconButtonStyle}" Width="36" Height="36" Click="CloseLyrics_Click" ToolTip="Close Lyrics">
                        <Path Data="{StaticResource IconTrash}" Fill="#B3FFFFFF" Width="16" Height="16" Stretch="Uniform"/>
                    </Button>

                    <Border Grid.Column="1" HorizontalAlignment="Center" Background="#26FFFFFF" CornerRadius="0" Padding="12,4" BorderBrush="#1CFFFFFF" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource IconButtonStyle}" Width="24" Height="24" Click="SpeedDecrease_Click" ToolTip="Slow Down">
                                <Path Data="{StaticResource IconMinus}" Fill="White" Width="10" Height="10" Stretch="Uniform"/>
                            </Button>
                            <TextBlock x:Name="SpeedText" Text="Speed 1.00x" Foreground="White" FontSize="11" FontWeight="Bold" Margin="12,0" VerticalAlignment="Center" Width="82" TextAlignment="Center"/>
                            <Button Style="{StaticResource IconButtonStyle}" Width="24" Height="24" Click="SpeedIncrease_Click" ToolTip="Speed Up">
                                <Path Data="{StaticResource IconPlus}" Fill="White" Width="10" Height="10" Stretch="Uniform"/>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Width="36" Height="36" Click="LoadLrcManually_Click" ToolTip="Load LRC Lyrics File">
                        <Path Data="{StaticResource IconPencil}" Fill="#B3FFFFFF" Width="16" Height="16" Stretch="Uniform"/>
                    </Button>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Grid>
</Window>
