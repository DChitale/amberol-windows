{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Amberol Windows",
  "version": "0.1.0",
  "identifier": "com.amberol.windows",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Amberol Windows",
        "width": 350,
        "height": 620,
        "minWidth": 320,
        "minHeight": 400,
        "decorations": false,
        "transparent": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; media-src 'self' blob: asset: http://asset.localhost https://asset.localhost; img-src 'self' blob: asset: http://asset.localhost https://asset.localhost data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**/*",
          "$HOME/**/*",
          "C:\\**\\*",
          "D:\\**\\*",
          "E:\\**\\*",
          "F:\\**\\*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/icon.ico"]
  }
}
